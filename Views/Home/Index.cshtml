
@{
    ViewData["Title"] = "Início";
}

<!-- Conteúdo principal -->
<img
    src="/imagens/Mulheres na Tecnologia_ Inovar e Inspirar.png"
    alt="Mulheres a trabalhar na área das tecnologias de informação"
    class="imagem-principal"
/>

<section class="hero text-center">

    <div class="container">

        <h1>Mulheres na Tecnologia</h1>

        <h2>O talento não tem género.</h2>

        <p>
            Conhece as mulheres que marcaram a história
            da tecnologia e que continuam a transformar
            o mundo digital.
        </p>

        <a asp-controller="Home"
           asp-action="Mulheres"
           class="btn btn-primary">
            Conhecer mulheres inspiradoras
        </a>

    </div>

</section>

<!-- Secção de apresentação -->
<section class="container my-5">

    <h2 class="text-center mb-4">
        Porque são importantes as mulheres na TI?
    </h2>

    <p class="intro-text">
        As mulheres desempenham um papel fundamental
        na evolução das Tecnologias de Informação.
        Ao longo da história, contribuíram para a
        programação, a informática, a inteligência
        artificial e muitas outras áreas.
    </p>

    <p class="intro-text">
        Este website pretende dar visibilidade aos
        seus contributos, celebrar as suas conquistas
        e incentivar mais mulheres a explorar o mundo
        da tecnologia.
    </p>

</section>

<section style="background-color: #142d4e;
                color: white;
                padding: 50px;
                text-align: center;
                margin: 30px;">

    <h2>O teu futuro também pode ser tecnológico!</h2>

    <p id="mensagem">
        A tecnologia precisa de novas ideias e talentos.
    </p>

    <button type="button"
            id="btnDescobre"
            class="btn btn-primary">
        Descobre mais
    </button>

</section>

</section>

