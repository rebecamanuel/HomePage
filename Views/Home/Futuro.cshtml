
@{
    ViewData["Title"] = "O Futuro das Mulheres na Tecnologia";
}

<!-- Banner da página -->
<section class="page-banner">

    <div class="container">

        <h1>O Futuro Também é Nosso</h1>

        <p>
            Uma tecnologia melhor nasce quando todas as pessoas
            têm oportunidades para aprender, participar e liderar.
        </p>

    </div>

</section>

<!-- Conteúdo principal -->
<section class="section-space">

    <div class="container">

        <div class="row g-4">

            <!-- Desafios existentes -->
            <div class="col-lg-6">

                <div class="content-panel">

                    <h2>Desafios que ainda existem</h2>

                    <ul>
                        <li>Falta de representatividade feminina.</li>
                        <li>Preconceitos e estereótipos.</li>
                        <li>Desigualdade de oportunidades.</li>
                        <li>Poucas mulheres em cargos de liderança.</li>
                    </ul>

                </div>

            </div>

            <!-- Como contribuir -->
            <div class="col-lg-6">

                <div class="content-panel">

                    <h2>Como podemos contribuir?</h2>

                    <ul>
                        <li>Dar visibilidade às mulheres na tecnologia.</li>
                        <li>Incentivar raparigas a estudar programação.</li>
                        <li>Partilhar conhecimentos e experiências.</li>
                        <li>Promover igualdade e respeito.</li>
                    </ul>

                </div>

            </div>

        </div>

        <!-- Mensagem final -->
        <div class="highlight-panel mt-5 text-center">

            <h2>O teu lugar também é na tecnologia!</h2>

            <p>
                Aprende, experimenta, acredita nas tuas capacidades
                e continua a criar.
            </p>

            <p id="fraseInspiradora"></p>

        </div>

    </div>

</section>
