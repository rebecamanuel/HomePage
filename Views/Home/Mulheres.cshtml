
@{
    ViewData["Title"] = "Mulheres Inspiradoras";
}

<section class="page-banner">
    <div class="container">
        <h1>Mulheres Negras Inspiradoras</h1>
        <p>Conhece algumas mulheres que fizeram história na ciência e na tecnologia.</p>
    </div>
</section>

<section class="section-space">
    <div class="container">

        <!-- Pesquisa -->
        <div class="search-container mb-5">

            <h2>Descobre mulheres inspiradoras</h2>

            <input
                type="text"
                id="pesquisaMulheres"
                class="form-control"
                placeholder="Pesquisar por nome ou profissão..."
                aria-label="Pesquisar mulheres inspiradoras" />

            <p id="resultadoPesquisa" class="mt-2"></p>

        </div>

        <!-- Cartões -->
        <div class="row g-4" id="listaMulheres">

            <div class="col-md-6 col-lg-3 cartao-mulher">
                <article class="profile-card">
                    <h2>Katherine Johnson</h2>
                    <p><strong>Matemática e cientista</strong></p>
                    <p>Os seus cálculos foram fundamentais para várias missões espaciais da NASA.</p>
                </article>
            </div>

            <div class="col-md-6 col-lg-3 cartao-mulher">
                <article class="profile-card">
                    <h2>Dorothy Vaughan</h2>
                    <p><strong>Matemática e programadora</strong></p>
                    <p>Trabalhou na NASA e aprendeu a programar em FORTRAN.</p>
                </article>
            </div>

            <div class="col-md-6 col-lg-3 cartao-mulher">
                <article class="profile-card">
                    <h2>Mary Jackson</h2>
                    <p><strong>Engenheira aeroespacial</strong></p>
                    <p>Foi a primeira engenheira negra da NASA.</p>
                </article>
            </div>

            <div class="col-md-6 col-lg-3 cartao-mulher">
                <article class="profile-card">
                    <h2>Gladys West</h2>
                    <p><strong>Matemática</strong></p>
                    <p>O seu trabalho contribuiu para o desenvolvimento da tecnologia GPS.</p>
                </article>
            </div>

        </div>

        <div class="highlight-panel mt-5">
            <h2>O que estas mulheres nos ensinam?</h2>
            <p>O conhecimento, a persistência e a dedicação podem abrir portas e transformar o mundo.</p>
        </div>

    </div>
</section>
